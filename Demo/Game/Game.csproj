<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<UseCommonOutputDirectory>false</UseCommonOutputDirectory>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="Primary">
			<HintPath>..\..\Primary\bin\Debug\net10.0\Primary.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Analyzer Include="..\..\Primary.SourceGenerator\bin\Debug\netstandard2.0\Primary.SourceGenerator.dll" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="copy $(OutDir)\Game.dll ..\VoxelizationDemo\Source\Library\Binary\Game.dll" />
		<Exec Command="copy $(OutDir)\Game.pdb ..\VoxelizationDemo\Source\Library\Binary\Game.pdb" />
	</Target>

</Project>
