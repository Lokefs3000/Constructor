<Widget Size="1.0 0 1.0 0">
    <Stylesheet Path="Editor/UI/Stylesheets/LayoutInspector.style" />
    <Stylesheet Path="Editor/UI/Stylesheets/Main.style" />

    <LayoutFrame Class="toolbar">
        <Button Id="window-button">
            <Label InputState="Never" Text="No window" />
        </Button>
    </LayoutFrame>
    <TreeView Id="hierchy" Class="background" Position="0.0 0 0.0 29" Size="0.2 0 1.0 -29">

    </TreeView>
    <Widget Id="sel-window-popup" Class="popup-darken" Size="1.0 0 1.0 0">
        <Widget Id="content" Class="background" Position="0.5 0 0.5 0" Size="0.8 0 0.8 0" Anchor="0.5 0.5">
            <LayoutFrame Id="list" Size="0.4 0 1.0 0">

            </LayoutFrame>
            <Widget Id="preview" Class="with-border-left" Position="0.4 0 0.0 0" Size="0.6 0 1.0 0">
                <Widget Id="background" Class="preview-background" Position="0.5 0 0.5 0" Anchor="0.5 0.5">
                    <Widget Id="rect" Class="preview-rect" />
                </Widget>
            </Widget>
        </Widget>
    </Widget>
</Widget>